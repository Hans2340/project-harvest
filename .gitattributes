# Normalize line endings so Windows/Mac/Linux teammates don't fight
* text=auto eol=lf

# Godot text resources: merge as text
*.gd       text diff
*.tscn     text eol=lf
*.tres     text eol=lf
*.godot    text eol=lf
*.cfg      text eol=lf
*.import   text eol=lf

# Binary assets
*.png  binary
*.jpg  binary
*.webp binary
*.ogg  binary
*.wav  binary
*.mp3  binary
*.ttf  binary
*.otf  binary
*.ase  binary
*.aseprite binary
*.kra  binary
*.psd  binary
